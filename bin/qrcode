#!/usr/bin/env node
// Argument parsing is node:util's parseArgs. This used to be yargs, which cost
// a runtime dependency tree for one CLI -- and yargs 18 dropped the
// `require('yargs')` singleton this file was written against, so every release
// of this fork shipped a `qrcode` command that crashed on start. What yargs did
// on top of parsing (aliases, number coercion, choices, implies, conflicts,
// --no-* negation, help and version) is spelled out below, with yargs's
// messages and precedence, so the output matches what yargs 15 printed.
const path = require('path')
const { parseArgs } = require('util')
const qr = require('../lib')

const $0 = path.basename(process.argv[1] || 'qrcode')

// key: the name yargs used in its messages (the short flag where there is one).
const OPTIONS = {
  qversion: { key: 'v', short: 'v', type: 'number' },
  error: { key: 'e', short: 'e', choices: ['L', 'M', 'Q', 'H'] },
  mask: { key: 'm', short: 'm', type: 'number' },
  type: { key: 't', short: 't', choices: ['png', 'svg', 'utf8'], implies: 'output' },
  inverse: { key: 'i', short: 'i', type: 'boolean' },
  width: { key: 'w', short: 'w', type: 'number', conflicts: 'scale' },
  scale: { key: 's', short: 's', type: 'number', conflicts: 'width' },
  qzone: { key: 'q', short: 'q', type: 'number' },
  lightcolor: { key: 'l', short: 'l' },
  darkcolor: { key: 'd', short: 'd' },
  small: { key: 'small', type: 'boolean', conflicts: 'type' },
  output: { key: 'o', short: 'o' },
  help: { key: 'h', short: 'h', type: 'boolean' },
  version: { key: 'version', type: 'boolean' }
}

function usage () {
  const examples = [
    [$0 + ' "some text"', 'Draw in terminal window'],
    [$0 + ' -o out.png "some text"', 'Save as png image'],
    [$0 + ' -d F00 -o out.png "some text"', 'Use red as foreground color']
  ]
  const width = Math.max.apply(null, examples.map((e) => e[0].length)) + 2

  return [
    'Usage: ' + $0 + ' [options] <input string>',
    '',
    'QR Code options:',
    '  -v, --qversion  QR Code symbol version (1 - 40)                       [number]',
    '  -e, --error     Error correction level           [choices: "L", "M", "Q", "H"]',
    '  -m, --mask      Mask pattern (0 - 7)                                  [number]',
    '',
    'Renderer options:',
    '  -t, --type        Output type                  [choices: "png", "svg", "utf8"]',
    '  -i, --inverse     Invert colors                                      [boolean]',
    '  -w, --width       Image width (px)                                    [number]',
    '  -s, --scale       Scale factor                                        [number]',
    '  -q, --qzone       Quiet zone size                                     [number]',
    '  -l, --lightcolor  Light RGBA hex color',
    '  -d, --darkcolor   Dark RGBA hex color',
    '  --small           Output smaller QR code to terminal                 [boolean]',
    '',
    'Options:',
    '  -o, --output  Output file',
    '  -h, --help    Show help                                              [boolean]',
    '  --version     Show version number                                    [boolean]',
    '',
    'Examples:'
  ].concat(examples.map((e) => '  ' + e[0].padEnd(width) + e[1])).join('\n')
}

// Like yargs: the usage on stderr, a blank line, the reason, exit 1.
function fail (message) {
  console.error(usage() + '\n\n' + message)
  process.exit(1)
}

function quote (value) {
  return typeof value === 'string' ? '"' + value + '"' : String(value)
}

function parse (args) {
  const config = {}
  for (const name in OPTIONS) {
    const def = OPTIONS[name]
    config[name] = { type: def.type === 'boolean' ? 'boolean' : 'string' }
    if (def.short) config[name].short = def.short
  }

  const values = {}
  const order = [] // option names in the order they first appear
  const positionals = []
  let terminated = false
  let start = 0

  // parseArgs gives a value-taking option the next word even when that word is
  // another option (`-v -o out.png`); yargs left the option empty instead. When
  // that happens, the option is recorded as empty and the rest re-parsed from
  // the word it swallowed. A negative number is still a value.
  parsing: while (true) {
    const { tokens } = parseArgs({
      args: args.slice(start),
      options: config,
      tokens: true,
      strict: false,
      allowPositionals: true,
      allowNegative: true
    })

    for (let i = 0; i < tokens.length; i++) {
      const token = tokens[i]
      if (token.kind === 'option-terminator') {
        terminated = true
        continue
      }
      if (token.kind === 'positional') {
        positionals.push(token.value)
        continue
      }

      const def = OPTIONS[token.name]
      const next = tokens[i + 1]
      const nextIsValue = next && next.kind === 'positional' && !terminated
      let raw = token.value
      let restart = false
      let value

      if (def && def.type !== 'boolean' && typeof raw === 'string' && !token.inlineValue &&
          /^-./.test(raw) && !/^-\d/.test(raw)) {
        raw = undefined
        restart = true
      }
      // `-w=12`: yargs read the value after the `=`; parseArgs keeps it.
      if (typeof raw === 'string' && token.inlineValue && token.rawName.length === 2 && raw[0] === '=') {
        raw = raw.slice(1)
      }

      if (!def) {
        // yargs takes the next word as an unknown option's value rather than as
        // part of the text, and otherwise ignores the option.
        if (token.inlineValue === undefined && nextIsValue) i++
        continue
      } else if (def.type === 'boolean') {
        if (token.rawName.startsWith('--no-')) {
          value = false
        } else if (raw !== undefined) {
          value = raw === 'true'
        } else if (nextIsValue && (next.value === 'true' || next.value === 'false')) {
          value = next.value === 'true'
          i++
        } else {
          value = true
        }
      } else if (raw === undefined) {
        // A flag given without a value: yargs dropped a number, and kept `true`
        // for anything else.
        value = def.type === 'number' ? undefined : true
      } else {
        value = def.type === 'number' ? Number(raw) : raw
      }

      if (!order.includes(token.name)) order.push(token.name)
      values[token.name] = value

      if (restart) {
        start += token.index + 1
        continue parsing
      }
    }
    break
  }

  return { values, order, text: positionals.join(' ') }
}

function validate (argv) {
  const { values, order } = argv
  const present = (name) => values[name] !== undefined

  for (const name of order) {
    const def = OPTIONS[name]
    if (def.choices && present(name) && !def.choices.includes(values[name])) {
      fail('Invalid values:\n  Argument: ' + def.key + ', Given: ' + quote(values[name]) +
        ', Choices: ' + def.choices.map(quote).join(', '))
    }
  }

  for (const name of order) {
    const def = OPTIONS[name]
    if (def.implies && present(name) && !present(def.implies)) {
      fail('Missing dependent arguments:\n ' + def.key + ' -> ' + def.implies)
    }
  }

  for (const name of order) {
    const def = OPTIONS[name]
    if (def.conflicts && present(name) && present(def.conflicts)) {
      fail('Arguments ' + def.key + ' and ' + def.conflicts + ' are mutually exclusive')
    }
  }
}

function save (file, text, options) {
  qr.toFile(file, text, options, function (err, data) {
    if (err) {
      console.error('Error:', err.message)
      process.exit(1)
    }

    console.log('saved qrcode to: ' + file + '\n')
  })
}

function print (text, options) {
  options.type = 'terminal'
  qr.toString(text, options, function (err, text) {
    if (err) {
      console.error('Error:', err.message)
      process.exit(1)
    }

    console.log(text)
  })
}

function parseOptions (args) {
  return {
    version: args.qversion,
    errorCorrectionLevel: args.error,
    type: args.type,
    small: !!args.small,
    inverse: !!args.inverse,
    maskPattern: args.mask,
    margin: args.qzone,
    width: args.width,
    scale: args.scale,
    color: {
      light: args.lightcolor,
      dark: args.darkcolor
    }
  }
}

function processInputs (text, opts) {
  if (!text.length) {
    console.error(usage())
    process.exit(1)
  }

  if (opts.output) {
    save(opts.output, text, parseOptions(opts))
  } else {
    print(text, parseOptions(opts))
  }
}

const argv = parse(process.argv.slice(2))

// --help and --version act before any validation; whichever comes first wins.
for (const name of argv.order) {
  if (name === 'help' && argv.values.help) {
    console.log(usage())
    process.exit(0)
  }
  if (name === 'version' && argv.values.version) {
    console.log(require('../package.json').version)
    process.exit(0)
  }
}

validate(argv)

if (process.stdin.isTTY) {
  processInputs(argv.text, argv.values)
} else {
  let text = ''
  process.stdin.setEncoding('utf8')
  process.stdin.on('readable', function () {
    const chunk = process.stdin.read()
    if (chunk !== null) {
      text += chunk
    }
  })

  process.stdin.on('end', function () {
    // this process can be run as a command outside of a tty so if there was no
    // data on stdin read from argv
    processInputs(text.length ? text : argv.text, argv.values)
  })
}
