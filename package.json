{
  "name": "@unabandoned/qrcode",
  "description": "QRCode / 2d Barcode api with both server side and client side support using canvas",
  "version": "1.6.0",
  "author": "Ryan Day <soldair@gmail.com>",
  "contributors": [
    "Vincenzo Greco <greco.vincenzo@gmail.com>",
    "Linus Unnebäck <linus@folkdatorn.se>"
  ],
  "keywords": [
    "qr",
    "code",
    "canvas",
    "qrcode"
  ],
  "main": "./lib/index.js",
  "browser": {
    "./lib/index.js": "./lib/browser.js",
    "fs": false
  },
  "files": [
    "bin",
    "build",
    "lib",
    "helper"
  ],
  "homepage": "https://github.com/unabandoned/node-qrcode#readme",
  "license": "MIT",
  "scripts": {
    "lint": "standard",
    "pretest": "npm run lint && tap build",
    "test": "node --throw-deprecation test.js",
    "build": "rollup -c",
    "browser": "node examples/clientsideserver.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "postbuild": "node scripts/verify-bundle.js"
  },
  "bin": {
    "qrcode": "./bin/qrcode"
  },
  "dependencies": {
    "dijkstrajs": "^1.0.1",
    "pngjs": "^7.0.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "browserify": "17.0.1",
    "canvas": "3.2.3",
    "canvasutil": "0.0.4",
    "colors": "1.4.0",
    "express": "5.2.1",
    "htmlparser2": "12.0.0",
    "rollup": "4.63.5",
    "sinon": "22.1.0",
    "standard": "17.1.2",
    "tap": "21.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/node-qrcode.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "standard": {
    "ignore": [
      "build/",
      "examples/vendors/",
      "lib/core/regex.js"
    ]
  },
  "bugs": {
    "url": "https://github.com/unabandoned/node-qrcode/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tap": {
    "plugin": [
      "!@tapjs/typescript"
    ]
  }
}
